@@ -89,6 +89,13 @@ struct kk_device {
 
    struct kk_sampler_heap samplers;
    struct kk_query_table occlusion_queries;
+   /* Occlusion queries take a table entry when first begun, not when their pool
+    * is made: a game made pools of 16384 queries and three of them filled the
+    * table, which Metal's 256 KiB visibility buffer limit caps at 32768.
+    * Queries not begun yet read oq_unused, which stays zero; queries begun when
+    * the table is full count into oq_spill. */
+   uint32_t oq_unused;
+   uint32_t oq_spill;
 
    /* Track all heaps the user allocated so we can set them all as resident when
     * recording as required by Metal. */
